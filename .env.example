# Runtime API configuration is NOT via Vite VITE_* env vars.
#
# Local: edit config/env-local.properties (see .example)
#        then: npm run config:generate
# Browser reads: public/app-config.json
#
# Phased rollout: set API_DEFAULT_MODE=mock and override per resource, e.g.
#   LANDING_METRICS_MODE=real
#   API_BASE_URL=https://api.company.com
