# =============================================================================
# Local developer configuration (template)
# Copy to env-local.properties and run: npm run config:generate
#
# Phase examples:
#   All mock (default): leave modes as mock
#   Landing real only:  LANDING_*_MODE=real + API_BASE_URL=https://api.company.com
# Values: mock | real
# =============================================================================

# --- Global defaults ---
API_DEFAULT_MODE=mock
API_BASE_URL=

# =============================================================================
# Landing page (/)
# =============================================================================
LANDING_METRICS_MODE=mock
LANDING_CONTENT_MODE=mock

# =============================================================================
# Session (shared — landing workspace CTA + workspace shell)
# =============================================================================
SESSION_CONTEXT_MODE=mock

# =============================================================================
# Workspace shell + Producer console (/workspace)
# =============================================================================
WORKSPACE_NAV_MODE=mock
WORKSPACE_CONSOLE_HERO_MODE=mock
WORKSPACE_CONSOLE_CHARTS_MODE=mock
WORKSPACE_CONSOLE_SUB_REQUESTS_MODE=mock
WORKSPACE_CONSOLE_CONSUMERS_MODE=mock
WORKSPACE_CONSOLE_GOVERNANCE_MODE=mock

# =============================================================================
# Producer · Bulk upload PDEs (/workspace/bulk-upload-pdes)
# =============================================================================
BULK_PDE_APPLICATIONS_MODE=mock
BULK_PDE_TEMPLATE_MODE=mock
BULK_PDE_PREVIEW_MODE=mock
BULK_PDE_REGISTER_MODE=mock

# =============================================================================
# Producer · Bind columns (/workspace/bind-columns)
# =============================================================================
BIND_COLUMNS_DATASETS_MODE=mock
BIND_COLUMNS_HARVEST_MODE=mock
BIND_COLUMNS_BDE_OPTIONS_MODE=mock
BIND_COLUMNS_PUBLISH_MODE=mock

# =============================================================================
# Producer · Workflow / Track workflow (/workspace/workflow)
# =============================================================================
WORKFLOW_BOARD_MODE=mock
WORKFLOW_APPROVE_MODE=mock
WORKFLOW_DECLINE_MODE=mock

# =============================================================================
# Catalogue · Physical datasets (/workspace/physical-datasets)
# =============================================================================
DATASETS_MODE=mock

# =============================================================================
# Catalogue · Logical model, Glossary terms, Lineage
# (/workspace/physical-datasets tabs + /workspace/lineage-explorer)
# =============================================================================
CATALOGUE_LOGICAL_MODEL_MODE=mock
CATALOGUE_BUSINESS_ELEMENTS_MODE=mock
CATALOGUE_GLOSSARY_TERMS_MODE=mock
CATALOGUE_LINEAGE_MODE=mock
CATALOGUE_LINEAGE_DETAILS_MODE=mock

# =============================================================================
# Planned (not wired in UI yet) — uncomment when needed
# =============================================================================
# NOTIFICATIONS_MODE=mock
# GOVERNANCE_MODE=mock
# SEARCH_MODE=mock
